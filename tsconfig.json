{
  "compilerOptions": {
    "target": "ES2020",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "types": ["node"],

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "sourceMap": true,

    "verbatimModuleSyntax": true,

    "isolatedModules": true
  },

  "include": ["src", "prisma/scripts"],

  "exclude": ["node_modules"]
}