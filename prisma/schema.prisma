generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * USER SYSTEM
 * =========================
 */

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum UserDepartment {
  BROADCAST
  MARKETING
}

enum UserPosition {
  PRODUCER
  POST_PRODUCTION_MANAGER
  TRANSLATOR
  VIEWER
  EDITOR
}

/**
 * =========================
 * ORDERS
 * =========================
 */

enum OrderType {
  BROADCAST
  MARKETING
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DeliveryFormat {
  TEXT
  SRT
  BURNED_IN
}

enum OrderPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  ORDER_COMPLETED
  STATUS_ADDED
  ASSIGNED_TO_ORDER
}

enum EventType {
  EWC
  ENC
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String?

  order TranslationOrder? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([isRead])
  @@index([createdAt])
}

/**
 * =========================
 * USER
 * =========================
 */

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String @unique

  password String?

  role UserRole @default(VIEWER)

  department UserDepartment?

  position UserPosition?

  assignedGames GameAssignment[]

  marketingAssignments MarketingOrderAssignment[]

  isActive Boolean @default(true)

  inviteToken  String?
  inviteExpiry DateTime?

  notifications Notification[]

  completedOrders TranslationOrder[] @relation("CompletedOrders")

  createdOrders TranslationOrder[] @relation("CreatedOrders")

  editedOrders TranslationOrderEdit[]

  lastEditedOrders TranslationOrder[] @relation("LastEditedBy")

  createdAt DateTime @default(now())

  @@index([role])
  @@index([department])
  @@index([position])
  @@index([isActive])
}

/**
 * =========================
 * GAMES
 * =========================
 */

model Game {
  id String @id @default(cuid())

  name String @unique

  logo String?

  broadcasts BroadcastDetails[]

  assignedUsers GameAssignment[]

  createdAt DateTime @default(now())

  @@index([name])
}

model GameAssignment {
  id String @id @default(cuid())

  userId String
  gameId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

/**
 * =========================
 * TRANSLATION ORDER
 * =========================
 */

model TranslationOrder {
  id String @id @default(cuid())

  type OrderType

  event EventType @default(EWC)

  title String

  notes String?

  status OrderStatus @default(PENDING)

  priority OrderPriority @default(MEDIUM)

  createdById String

  createdBy User @relation("CreatedOrders", fields: [createdById], references: [id])

  dateAdded DateTime @default(now())

  completedById String?

  completedBy User? @relation("CompletedOrders", fields: [completedById], references: [id])

  completedAt DateTime?

  /**
   * LAST EDIT
   */

  lastEditedById String?

  lastEditedBy User? @relation("LastEditedBy", fields: [lastEditedById], references: [id])

  lastEditedAt DateTime?

  /**
   * HISTORY
   */

  editHistory TranslationOrderEdit[]

  notifications Notification[]

  broadcast BroadcastDetails?

  marketing MarketingDetails?

  @@index([event])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([completedById])
  @@index([lastEditedById])
  @@index([dateAdded])
  @@index([event, status])
  @@index([type, status])
}

model TranslationOrderEdit {
  id String @id @default(cuid())

  orderId String

  order TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  editedById String

  editedBy User @relation(fields: [editedById], references: [id], onDelete: Cascade)

  editedAt DateTime @default(now())

  @@index([orderId])
  @@index([editedById])
  @@index([editedAt])
}

model BroadcastDetails {
  id String @id @default(cuid())

  gameId String

  game Game @relation(fields: [gameId], references: [id])

  estimatedMinutes Int

  sourceLanguage String[]

  targetLanguages String[]

  sourceFileLink String?

  srtAvailableLink String?

  deliveryDate DateTime

  deadlineDate DateTime

  orderId String @unique

  order TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveries BroadcastDelivery[]

  deliveryFormats BroadcastDeliveryFormat[]

  @@index([gameId])
  @@index([deliveryDate])
  @@index([deadlineDate])
}

model MarketingDetails {
  id String @id @default(cuid())

  contentTitle String?

  sourceLanguage String[]

  targetLanguages String[]

  sourceFileLink String?

  srtAvailableLink String?

  deadlineDate DateTime?

  orderId String @unique

  order TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveries MarketingDelivery[]

  deliveryFormats MarketingDeliveryFormat[]

  assignments MarketingOrderAssignment[]
}

model BroadcastDelivery {
  id String @id @default(cuid())

  language String

  deliveryLink String?

  broadcastId String

  broadcast BroadcastDetails @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, language])
  @@index([broadcastId])
}

model MarketingDelivery {
  id String @id @default(cuid())

  language String

  deliveryLink String?

  marketingId String

  marketing MarketingDetails @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  @@unique([marketingId, language])
  @@index([marketingId])
}

model BroadcastDeliveryFormat {
  id String @id @default(cuid())

  format DeliveryFormat

  deliveryLink String?

  broadcastId String

  broadcast BroadcastDetails @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, format])
  @@index([broadcastId])
}

model MarketingDeliveryFormat {
  id String @id @default(cuid())

  format DeliveryFormat

  deliveryLink String?

  marketingId String

  marketing MarketingDetails @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  @@unique([marketingId, format])
  @@index([marketingId])
}

model MarketingOrderAssignment {
  id String @id @default(cuid())

  userId String

  marketingId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketing MarketingDetails @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, marketingId])
  @@index([userId])
  @@index([marketingId])
}
