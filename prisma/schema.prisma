generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * USER SYSTEM
 * =========================
 */

enum UserRole {
  ADMIN
  USER
}

enum UserDepartment {
  BROADCAST
  MARKETING
}

enum UserPosition {
  PRODUCER
  POST_PRODUCTION_MANAGER
  TRANSLATOR
  // Vendor translator roles — same visibility/behavior as TRANSLATOR.
  TRANSPERFECT
  TARJAMA
  VIEWER
  EDITOR
  VIDEO_EDITOR
}

/**
 * =========================
 * ORDERS
 * =========================
 */

enum OrderType {
  BROADCAST
  MARKETING
}

enum OrderStatus {
  PENDING
  READY_FOR_TRANSLATION
  IN_PROGRESS
  COMPLETED
}

enum DeliveryFormat {
  TEXT
  SRT
  BURNED_IN
  EMBEDDED_SUBS
  ON_SCREEN_TEXT
  GRAPHIC_TEXT
  VO_TRANSLATIONS
  GOOGLE_SHEET
}

// Broadcast only: whether the deliverable is a finished asset (SRT or burned-in)
// or raw (SRT only).
enum DeliveryType {
  FINISHED
  RAW
}

enum OrderPriority {
  LOW
  MEDIUM
  HIGH
}

// Broadcast content type + its expected turnaround (informational). The hours
// are the target time each should take: RAW ASAP, OPENER 2h, HYPE_PROMO 4h,
// ENGAGEMENT 5h, LONG_FORM 8h, EXPLAINER 12h.
enum ContentCategory {
  RAW
  OPENER
  HYPE_PROMO
  ENGAGEMENT
  LONG_FORM
  EXPLAINER
}

enum NotificationType {
  ORDER_COMPLETED
  ORDER_REOPENED
  STATUS_ADDED
  ASSIGNED_TO_ORDER
  FEEDBACK_ADDED
}

enum EventType {
  EWC
  ENC
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String?

  order TranslationOrder? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderId, userId, type])
  @@index([userId])
  @@index([orderId])
  @@index([isRead])
  @@index([createdAt])
}

/**
 * =========================
 * USER
 * =========================
 */

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String @unique

  password String?

  role UserRole @default(USER)

  department UserDepartment?

  position UserPosition?

  // Languages a TRANSLATOR specializes in (what they're good at translating into).
  // Used to route source-file emails to matching translators only. Language names,
  // e.g. ["Arabic","French"]. Empty/ignored for non-translator positions.
  specialtyLanguages String[] @default([])

  assignedGames GameAssignment[]

  marketingAssignments MarketingOrderAssignment[]

  isActive Boolean @default(true)

  inviteToken  String?   @unique
  inviteExpiry DateTime?

  resetToken  String?   @unique
  resetExpiry DateTime?

  loginFailures Int       @default(0)
  lockedUntil   DateTime?

  notifications Notification[]

  completedOrders TranslationOrder[] @relation("CompletedOrders")

  createdOrders TranslationOrder[] @relation("CreatedOrders")

  editedOrders TranslationOrderEdit[]

  lastEditedOrders TranslationOrder[] @relation("LastEditedBy")

  orderFeedback OrderFeedback[] @relation("FeedbackAuthor")

  feedbackReads FeedbackRead[]

  createdAt DateTime @default(now())

  @@index([role])
  @@index([department])
  @@index([position])
  @@index([isActive])
  @@index([inviteToken])
  @@index([resetToken])
  @@index([lockedUntil])
}

/**
 * =========================
 * GAMES
 * =========================
 */

model Game {
  id String @id @default(cuid())

  name String @unique

  logo String?

  // Production tier: 1 = highest, 3 = lowest. New games default to 3.
  tier Int @default(3)

  // Extra "Tier 1 CN" designation — some games carry this ON TOP of their normal
  // tier. Shown as its own badge in the broadcast table.
  tier1CN Boolean @default(false)

  broadcasts BroadcastDetails[]

  assignedUsers GameAssignment[]

  createdAt DateTime @default(now())

  @@index([name])
  @@index([tier])
}

model GameAssignment {
  id String @id @default(cuid())

  userId String
  gameId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

/**
 * =========================
 * TRANSLATION ORDER
 * =========================
 */

model TranslationOrder {
  id String @id @default(cuid())

  type OrderType

  event EventType @default(EWC)

  title String

  notes String?

  status OrderStatus @default(PENDING)

  priority OrderPriority @default(MEDIUM)

  createdById String

  createdBy User @relation("CreatedOrders", fields: [createdById], references: [id])

  dateAdded DateTime @default(now())

  completedById String?

  completedBy User? @relation("CompletedOrders", fields: [completedById], references: [id])

  completedAt DateTime?

  // Status-transition timestamps — set the moment the order ENTERS that status,
  // so the sidebar can show when each stage began and how long each took
  // (Ready → In Progress, In Progress → Completed).
  readyAt      DateTime?
  inProgressAt DateTime?

  /**
   * LAST EDIT
   */

  lastEditedById String?

  lastEditedBy User? @relation("LastEditedBy", fields: [lastEditedById], references: [id])

  lastEditedAt DateTime?

  // Set when the source file is CHANGED (replaced) on an existing order, so a
  // caution flag can warn translators who may be working off the old source.
  // Cleared when the order is opened.
  sourceChangedAt DateTime?

  // Which translator positions receive the "source file ready/updated" email for
  // this order (chosen via pills when a source file is added). Values are
  // UserPosition names, e.g. ["TRANSLATOR","TARJAMA"]. Empty on legacy orders →
  // recipients fall back to TRANSPERFECT.
  notifyPositions String[] @default([])

  /**
   * HISTORY
   */

  editHistory TranslationOrderEdit[]

  notifications Notification[]

  feedback OrderFeedback[]

  broadcast BroadcastDetails?

  marketing MarketingDetails?

  /**
   * SUB-ORDERS (self-relation)
   * A "big order" (isParent=true) groups multiple sub-orders.
   * A sub-order has parentId set and carries its own full details.
   * A standalone order has isParent=false and parentId=null.
   */

  isParent Boolean @default(false)

  parentId String?

  parent TranslationOrder? @relation("OrderSubOrders", fields: [parentId], references: [id], onDelete: Cascade)

  subOrders TranslationOrder[] @relation("OrderSubOrders")

  @@index([event])
  @@index([type])
  @@index([status])
  @@index([parentId])
  @@index([priority])
  @@index([createdById])
  @@index([completedById])
  @@index([lastEditedById])
  @@index([dateAdded])
  @@index([event, status])
  @@index([type, status])
}

model TranslationOrderEdit {
  id String @id @default(cuid())

  orderId String

  order TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  editedById String

  editedBy User @relation(fields: [editedById], references: [id], onDelete: Cascade)

  editedAt DateTime @default(now())

  @@index([orderId])
  @@index([editedById])
  @@index([editedAt])
}

model BroadcastDetails {
  id String @id @default(cuid())

  gameId String

  game Game @relation(fields: [gameId], references: [id])

  estimatedMinutes Int

  sourceLanguage String[]

  targetLanguages String[]

  sourceFileLink String?

  srtAvailableLink String?

  deliveryDate DateTime

  deadlineDate DateTime

  // Whether deadlineDate carries a specific time-of-day (true) or is date-only
  // (false → stored at UTC midnight, displayed without a time).
  deadlineHasTime Boolean @default(false)

  // Finished (SRT or burned-in) vs Raw (SRT only). Gates the delivery format.
  deliveryType DeliveryType?

  // Content type (drives the expected turnaround; see ContentCategory).
  contentCategory ContentCategory?

  orderId String @unique

  order TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveries BroadcastDelivery[]

  deliveryFormats BroadcastDeliveryFormat[]

  @@index([gameId])
  @@index([deliveryDate])
  @@index([deadlineDate])
}

model MarketingDetails {
  id String @id @default(cuid())

  contentTitle String?

  // Aspect ratios / sizes for the asset (marketing only): "1x1", "4x5", "9x16", "16x9".
  aspectRatios String[]

  sourceLanguage String[]

  targetLanguages String[]

  sourceFileLink String?

  srtAvailableLink String?

  // Deadline as an absolute instant. deadlineHasTime distinguishes a real
  // time-of-day deadline (true) from a date-only deadline (false → stored at
  // UTC midnight, displayed without a time).
  deadlineDate DateTime?

  deadlineHasTime Boolean @default(false)

  orderId String @unique

  order TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveries MarketingDelivery[]

  deliveryFormats MarketingDeliveryFormat[]

  assignments MarketingOrderAssignment[]

  @@index([deadlineDate])
}

model BroadcastDelivery {
  id String @id @default(cuid())

  language String

  deliveryLink String?

  broadcastId String

  broadcast BroadcastDetails @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, language])
  @@index([broadcastId])
}

model MarketingDelivery {
  id String @id @default(cuid())

  language String

  deliveryLink String?

  marketingId String

  marketing MarketingDetails @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  @@unique([marketingId, language])
  @@index([marketingId])
}

model BroadcastDeliveryFormat {
  id String @id @default(cuid())

  format DeliveryFormat

  deliveryLink String?

  broadcastId String

  broadcast BroadcastDetails @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, format])
  @@index([broadcastId])
}

model MarketingDeliveryFormat {
  id String @id @default(cuid())

  format DeliveryFormat

  deliveryLink String?

  marketingId String

  marketing MarketingDetails @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  @@unique([marketingId, format])
  @@index([marketingId])
}

model MarketingOrderAssignment {
  id String @id @default(cuid())

  userId String

  marketingId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketing MarketingDetails @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, marketingId])
  @@index([userId])
  @@index([marketingId])
}

// Translator feedback / comments on an order. Shared thread (everyone who can
// view the order sees all entries); only the author can edit or delete theirs.
model OrderFeedback {
  id String @id @default(cuid())

  orderId String
  order   TranslationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  message String

  reads FeedbackRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([authorId])
}

// Per-user read receipt for a feedback message. A row exists once a user has
// "seen" that message (it scrolled into view for a few seconds). The unread
// badge counts feedback the viewer didn't author and has no read receipt for.
model FeedbackRead {
  id String @id @default(cuid())

  feedbackId String
  feedback   OrderFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([feedbackId, userId])
  @@index([userId])
  @@index([feedbackId])
}

